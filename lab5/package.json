{
  "name": "adboard-lab5",
  "version": "1.0.0",
  "description": "AdBoard \u2014 Lab 5: Unit tests, Jest + RTL, coverage >70%",
  "type": "module",
  "scripts": {
    "dev": "vite --port 8000",
    "build": "vite build",
    "preview": "vite preview --port 8000",
    "lint": "eslint \"src/**/*.{js,jsx}\" --ignore-pattern node_modules/",
    "mock-api": "json-server --watch db.json --port 3001",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text --coverageReporters=lcov"
    
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.2",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.2.1",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "json-server": "^0.17.4",
    "vite": "^5.1.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "moduleNameMapper": {
      "\\.(css|scss|png|jpg|svg)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json",
      "node"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/main.jsx",
      "!src/styles/**",
      "!src/setupTests.js",
      "!src/App.jsx",
      "!src/pages/AnnouncementCreatePage.jsx",
      "!src/pages/AnnouncementEditPage.jsx",
      "!src/pages/AnnouncementDetailPage.jsx",
      "!src/pages/UserCreatePage.jsx",
      "!src/pages/UserEditPage.jsx",
      "!src/pages/UserDetailPage.jsx",
      "!src/pages/DashboardPage.jsx",
      "!src/components/layout/AppLayout.jsx",
      "!src/components/layout/Sidebar.jsx"
    ],
    "testMatch": [
      "**/__tests__/**/*.{js,jsx}",
      "**/*.test.{js,jsx}"
    ],
    "setupFilesAfterFramework": [
      "<rootDir>/src/setupTests.js"
    ],
    "coverageReporters": ["clover", "json", "lcov", "text"]
    
  }
}